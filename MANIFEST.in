include LICENSE README.md pyproject.toml
recursive-include src/admin_htmx *.py py.typed *.html *.js *LICENSE
recursive-include tests *.py
recursive-include example *.py *.html *.js
recursive-include docs *.md
recursive-include scripts *.py
prune example/media
prune example/staticfiles
global-exclude __pycache__ *.py[cod] *.sqlite3
